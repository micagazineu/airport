meta {
  name: Calculate Distance
  type: http
  seq: 1
}

post {
  url: {{base_url}}/airports/distance
  body: multipartForm
  auth: none
}

body:multipart-form {
  from: LHR
  to: JFK
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("calculates distance correctly", function() {
    const data = res.getBody();
    expect(data.data.attributes.kilometers).to.be.a('number');
    expect(data.data.attributes.miles).to.be.a('number');
    expect(data.data.attributes.nautical_miles).to.be.a('number');
  });
}
