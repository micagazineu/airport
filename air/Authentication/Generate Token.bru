meta {
  name: Generate Token
  type: https://airportgap.com/api/tokens
  seq: 1
}

post {
  url: {{https://airportgap.com/api}}/tokens
  body: multipartForm
  auth: none
}

body:multipart-form {
  email: {{test@airportgap.com}}
  password: {{airportgappassword}}
}

vars:post-response {
  token: res.getBody().token
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns a token", function() {
    expect(res.getBody().token).to.be.a('string');
  });
}
