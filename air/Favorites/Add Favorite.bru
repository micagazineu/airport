meta {
  name: Add Favorite
  type: http
  seq: 1
}

post {
  url: {{base_url}}/favorites
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  airport_id: KIX
  note: My favorite airport
}

tests {
  test("status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
