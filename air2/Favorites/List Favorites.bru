meta {
  name: List Favorites
  type: http
  seq: 2
}

get {
  url: {{base_url}}/favorites
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns data array", function() {
    expect(res.getBody().data).to.be.an('array');
  });
}
